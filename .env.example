# ==============================================================================
# Trailmark Environment Configuration Template (.env.example)
# Copy this file to '.env' and fill in your values.
# ==============================================================================

# --- AI & Vision Services (Phase 2 Curation) ---
# Required for --curate-ai flag
GEMINI_API_KEY=""

# Model to use for vision scoring and narrative generation (default: gemini-3.8-flash)
# Options: gemini-3.8-flash, gemini-2.5-flash, gemini-3.0-flash, gemini-2.5-flash-lite
GEMINI_MODEL="gemini-3.8-flash"

# Optional: Override Gemini API base URL (useful for local proxies or API gateways)
# GEMINI_BASE_URL="https://generativelanguage.googleapis.com/v1beta/models"

# --- Web Enrichment (Apify - Phase 2) ---
# Required for --enrich-apify flag
APIFY_TOKEN=""

# Optional: Custom Apify API base URL
# APIFY_API_BASE="https://api.apify.com/v2"

# Optional: Custom Apify Actor ID for POI crawling (default: compass/crawler-google-places)
# APIFY_ACTOR_PLACES="compass/crawler-google-places"

# --- Geocoding & OpenStreetMap Nominatim (Phase 1) ---
# User-Agent header for Nominatim requests (OpenStreetMap policy requires identifiable contact info)
NOMINATIM_USER_AGENT="Trailmark/1.0 (https://github.com/yourusername/trailmark)"

# Optional: Self-hosted or custom Nominatim endpoint for high-volume geocoding
# NOMINATIM_BASE_URL="https://nominatim.openstreetmap.org/reverse"

# Optional: Custom directory to store geocache.json (default: ~/.cache/trailmark)
# TRAILMARK_CACHE_DIR=""

# --- System Binaries ---
# Optional: Explicit path to exiftool binary if not in standard PATH
# EXIFTOOL_PATH="/usr/local/bin/exiftool"

# --- FreeLLM Gateway (Companion AI Proxy Service) ---
# Optional: Server host, port, and compression mode
# FREELLM_PORT=20128
# FREELLM_HOST=127.0.0.1
# FREELLM_COMPRESSION_MODE="stacked"

# Provider API Keys for FreeLLM Gateway (comma-separated for multi-key pooling)
# MISTRAL_API_KEY=""
# GROQ_API_KEY=""
# CEREBRAS_API_KEY=""
# SAMBANOVA_API_KEY=""
# SILICONFLOW_API_KEY=""
# ZHIPU_API_KEY=""
# CLOUDFLARE_ACCOUNT_ID=""
# CLOUDFLARE_API_KEY=""

